NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-14
NEXT_PUBLIC_SITE_URL=https://www.bogeys2birdies.co.uk

# Server-only content management credentials. Never prefix the token with NEXT_PUBLIC_.
SANITY_PROJECT_ID=your-project-id
SANITY_DATASET=production
SANITY_API_WRITE_TOKEN=your-write-token

# Server-only comment notification settings. Never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=re_your-server-only-api-key
COMMENT_NOTIFICATION_EMAIL=hello@bogeys2birdies.co.uk
COMMENT_NOTIFICATION_FROM=Bogeys2Birdies <comments@bogeys2birdies.co.uk>
SANITY_STUDIO_URL=https://bogeys2birdies.sanity.studio/structure/comment

# Server-only newsletter settings. NEWSLETTER_SEND_TOKEN protects the send endpoint.
NEWSLETTER_FROM_EMAIL=hello@bogeys2birdies.co.uk
NEWSLETTER_REPLY_TO_EMAIL=hello@bogeys2birdies.co.uk
NEWSLETTER_PUBLIC_SITE_URL=https://www.bogeys2birdies.co.uk
NEWSLETTER_SEND_TOKEN=replace-with-a-long-random-secret
NEWSLETTER_UNSUBSCRIBE_SECRET=replace-with-a-long-random-secret

FIREBASE_PROJECT_ID=precision-golf-fc3bd
PRECISION_GOLF_SYNC_ALLOWED_UID=your-firebase-user-uid
